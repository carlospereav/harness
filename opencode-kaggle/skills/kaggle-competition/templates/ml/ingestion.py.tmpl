# DataIngestion_Node - Traditional ML
# Competition: {{competition}}
# Purpose: recursively walk /kaggle/input, print what's mounted, and load
# train/test/sample-submission CSVs by name wherever they are found.
import os

import pandas as pd

DATA_DIR = "/kaggle/input"
print(f"[ingestion] walking {DATA_DIR} (competition: {{competition}})")

train_df = None
test_df = None
sample_sub = None

# Walk recursively and print every file found.
for root, dirs, files in os.walk(DATA_DIR):
    for fname in sorted(files):
        fpath = os.path.join(root, fname)
        print(f"[ingestion]   found: {fpath}")
        if fname.endswith("train.csv") or fname.endswith("train.zip"):
            train_df = pd.read_csv(fpath)
        elif fname.endswith("test.csv") or fname.endswith("test.zip"):
            test_df = pd.read_csv(fpath)
        elif "sample_submission" in fname:
            sample_sub = pd.read_csv(fpath)

if train_df is not None:
    print(f"[ingestion] train shape: {train_df.shape}")
    print(f"[ingestion] train columns: {list(train_df.columns)}")
else:
    print("[ingestion] WARNING: no train.csv found — check competition data mount")

if test_df is not None:
    print(f"[ingestion] test shape: {test_df.shape}")
    print(f"[ingestion] test columns: {list(test_df.columns)}")

if sample_sub is not None:
    print(f"[ingestion] sample_submission shape: {sample_sub.shape}")
