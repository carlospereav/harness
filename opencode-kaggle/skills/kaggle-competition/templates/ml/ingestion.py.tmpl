# Competition: {{competition}}
# Purpose: access and load raw tabular data from the Kaggle input mount.
import os

import pandas as pd

DATA_DIR = "/kaggle/input/{{competition}}"
print(f"[ingestion] scanning {DATA_DIR}")

train_df = None
test_df = None
sample_sub = None
if os.path.isdir(DATA_DIR):
    for fname in sorted(os.listdir(DATA_DIR)):
        fpath = os.path.join(DATA_DIR, fname)
        if fname.endswith("train.csv") or fname.endswith("train.zip"):
            train_df = pd.read_csv(fpath)
        elif fname.endswith("test.csv") or fname.endswith("test.zip"):
            test_df = pd.read_csv(fpath)
        elif "sample_submission" in fname:
            sample_sub = pd.read_csv(fpath)

if train_df is not None:
    print(f"[ingestion] train shape: {train_df.shape}")
if test_df is not None:
    print(f"[ingestion] test shape: {test_df.shape}")
if sample_sub is not None:
    print(f"[ingestion] sample_submission shape: {sample_sub.shape}")