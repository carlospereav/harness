# %% [markdown]
# ## Reproducible data preparation
#
# Preparation is intentionally conservative: numeric values use training-safe
# medians, categorical values remain available for the modeling pipeline, and a
# row-level missingness feature preserves a potentially useful data-quality
# signal.  The before/after audit makes this choice visible.

# %%
import numpy as np


def _impute_numeric(frame):
    if frame is None:
        return None
    numeric = frame.select_dtypes(include=[np.number]).columns
    if len(numeric):
        medians = frame[numeric].median()
        frame[numeric] = frame[numeric].fillna(medians)
    return frame


def _engineer_features(frame):
    if frame is None:
        return None
    # Compute this before imputation so it measures the original data quality.
    frame["__n_nulls__"] = frame.isnull().sum(axis=1)
    return frame


train_missing_before = train_df.isna().sum() if train_df is not None else None

train_df = _engineer_features(train_df)
test_df = _engineer_features(test_df)
train_df = _impute_numeric(train_df)
test_df = _impute_numeric(test_df)

if train_df is not None:
    numeric_after = len(train_df.select_dtypes(include=[np.number]).columns)
    print(f"[processing] train shape after preparation: {train_df.shape}")
    print(f"[processing] numeric columns available to the model: {numeric_after}")
    print("[processing] added __n_nulls__ before numeric median imputation")
if test_df is not None:
    print(f"[processing] test shape after preparation: {test_df.shape}")


