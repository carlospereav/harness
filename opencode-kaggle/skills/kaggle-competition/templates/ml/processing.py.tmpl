# DataProcessing_Node - Traditional ML
# Purpose: transform raw data into the exact shape the training engine needs
# (null imputation, normalization, feature engineering).
import numpy as np


def _impute_numeric(df):
    if df is None:
        return None
    num_cols = df.select_dtypes(include=[np.number]).columns
    if len(num_cols):
        med = df[num_cols].median()
        df[num_cols] = df[num_cols].fillna(med)
    return df


def _engineer_features(df):
    if df is None:
        return None
    # example feature: row-level null count (often signal-bearing)
    df["__n_nulls__"] = df.isnull().sum(axis=1)
    return df


