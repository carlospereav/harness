# Experimentation_Node - Traditional ML (optimization loop, iteration {{iteration}})
# Purpose: train algorithms, tune hyperparameters, read stdout to evaluate.
# Uses HistGradientBoostingClassifier which handles categoricals and NaN
# natively — no manual encoding/imputation required.
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.model_selection import cross_val_score
from sklearn.preprocessing import LabelEncoder
import numpy as np

# NOTE: the agent rewrites this cell each iteration based on Evaluation_Node
# feedback. The metric emitted here is an intermediate training signal; the
# PRIMARY metric is emitted by Evaluation_Node.
model = None
train_loss = 1.0
if train_df is not None:
    # Determine target column: look for 'target' in column names, or use the last column.
    target_col = None
    for col in train_df.columns:
        col_lower = col.lower()
        if col_lower == "target" or col_lower.startswith("target_"):
            target_col = col
            break
    if target_col is None:
        target_col = train_df.columns[-1]

    y_raw = train_df[target_col]

    # Handle categorical targets (LabelEncoder for string labels).
    le = None
    if y_raw.dtype == object or y_raw.dtype.name == "category":
        le = LabelEncoder()
        y = le.fit_transform(y_raw.astype(str))
    else:
        y = y_raw

    # Feature columns = everything except id-like and target.
    feature_cols = [c for c in train_df.columns
                    if c != target_col and c.lower() not in ("id",)]
    X = train_df[feature_cols]

    # HistGradientBoostingClassifier handles categoricals via OrdinalEncoder
    # automatically when categorical_features is specified. For simplicity,
    # let the classifier auto-detect object/category columns.
    n_estimators = 50 + 25 * {{iteration}}
    kwargs = {}
    # If scikit-learn >= 1.2, we can pass categorical_features='from_dtype' or a list.
    # Fallback: just let it run — it handles NaN natively and will ordinal-encode strings.
    try:
        model = HistGradientBoostingClassifier(
            n_estimators=n_estimators, random_state=42
        )
    except Exception:
        # Fallback for older sklearn versions
        model = HistGradientBoostingClassifier(
            max_iter=n_estimators, random_state=42
        )

    try:
        scores = cross_val_score(model, X, y, cv=3, scoring="accuracy")
        train_loss = float(1.0 - scores.mean())
    except Exception:
        # Cross-validation may fail on small datasets or rare cases; try direct fit.
        try:
            model.fit(X, y)
            train_loss = 0.5  # placeholder when CV fails
        except Exception as exc:
            print(f"[experimentation] model fit failed: {exc}")
            model = None

    if model is not None:
        try:
            model.fit(X, y)
        except Exception as exc:
            print(f"[experimentation] final fit failed: {exc}")
            model = None

print(f"#METRIC:train_loss={train_loss:.4f}")
print(f"[experimentation iter={{iteration}}] model trained (max_iter={50 + 25 * {{iteration}}})")
